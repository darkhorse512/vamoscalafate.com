{
  "name": "@vamos/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./generated/client/client.ts",
    "./enums": "./generated/client/enums.ts",
    "./models": "./generated/client/models.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@vamos/db: no lint target\""
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.4",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}