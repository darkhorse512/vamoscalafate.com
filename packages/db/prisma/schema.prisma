// ════════════════════════════════════════════════════════════════════════════
// VAMOS CALAFATE - canonical database schema
//
// This is the ONLY schema in the monorepo. Both `web` and `admin` consume the
// generated client through @vamos/db. Never duplicate models in an app.
//
// Conventions
//  · Money is stored in MINOR UNITS (centavos/cents) as Int. Never Float.
//    A price of ARS 145.000,00 is stored as 14500000.
//  · Business entities are soft-deleted (status ARCHIVED / deletedAt), never
//    hard-deleted, so bookings keep referential history.
//  · Every public-facing entity owns an optional SeoMetadata row.
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
  moduleFormat = "esm"
  runtime = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── ENUMS ──────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  BOOKING_MANAGER
  CONTENT_MANAGER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  MERCADOPAGO
  STRIPE
  MANUAL
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
  SENIOR
}

enum FaqScope {
  GLOBAL
  TOUR
  DESTINATION
  BLOG
  BOOKING
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGIN_FAILED
  LOGOUT
  APPROVE
  REJECT
  REFUND
  EXPORT
}

// ─────────────────────── AUTH / RBAC / AUDIT ────────────────────────────────

/// Staff account for admin.vamoscalafate.com. Distinct from `Customer`:
/// customers never receive admin credentials.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)

  // Brute-force protection. Cleared on successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        AdminSession[]
  auditLogs       AuditLog[]
  uploadedMedia   Media[]         @relation("MediaUploader")
  authoredPosts   BlogPost[]      @relation("PostAuthor")
  reviewedSubmits HotelSubmission[] @relation("SubmissionReviewer")

  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

/// Server-side session store. The cookie carries an opaque random token; only
/// its SHA-256 hash is persisted, so a database leak cannot be replayed.
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Queryable representation of the RBAC matrix rendered in the admin UI.
/// The authoritative matrix lives in packages/shared/src/rbac.ts so that
/// authorization checks need no database round-trip; `pnpm db:seed` keeps
/// these rows in sync with it.
model Role {
  id          String    @id @default(cuid())
  key         AdminRole @unique
  name        String
  description String

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  resource    String
  action      String
  description String

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Immutable trail of sensitive admin actions: who / what / when / before / after.
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String?
  summary    String

  before Json?
  after  Json?

  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

/// Durable rate-limit buckets. Survives restarts and is shared by both apps,
/// which an in-memory counter behind PM2 cluster mode would not be.
model RateLimitCounter {
  id        String   @id @default(cuid())
  bucketKey String   @unique
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// ────────────────────────────── SEO ─────────────────────────────────────────

/// Per-entity SEO overrides edited from the admin SEO editor. Every field is
/// optional: when null, the app falls back to sensible derived defaults.
model SeoMetadata {
  id              String  @id @default(cuid())
  title           String?
  description     String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?
  noindex         Boolean @default(false)
  nofollow        Boolean @default(false)
  structuredData  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour        Tour?
  hotel       Hotel?
  business    Business?
  destination Destination?
  blogPost    BlogPost?
  category    TourCategory?
  page        StaticPage?

  @@map("seo_metadata")
}

// ───────────────────────────── MEDIA ────────────────────────────────────────

model Media {
  id       String    @id @default(cuid())
  type     MediaType @default(IMAGE)
  /// Storage key relative to the configured driver root (local dir or bucket).
  storageKey String  @unique
  url        String
  filename   String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  /// Tiny base64 placeholder used by next/image `blurDataURL` to avoid CLS.
  blurDataUrl String?
  altText    String?
  caption    String?
  /// For MediaType.VIDEO pointing at YouTube/Vimeo rather than a stored file.
  externalUrl String?

  /// Licensing provenance.
  ///
  /// Required for anything imported under a Creative Commons licence: CC BY
  /// and CC BY-SA oblige us to credit the author and name the licence
  /// wherever the work is shown. Storing it on the row is what makes that
  /// credit automatic rather than something a person has to remember.
  license         String?
  attributionText String?
  attributionUrl  String?
  sourceUrl       String?

  uploadedById String?
  uploadedBy   AdminUser? @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourImages     TourImage[]
  tourVideos     TourVideo[]
  hotelImages    HotelImage[]
  hotelVideos    HotelVideo[]
  businessImages BusinessImage[]
  blogHeroFor    BlogPost[]      @relation("BlogHero")
  destinationHeroFor Destination[] @relation("DestinationHero")
  attractionImageFor Attraction[]  @relation("AttractionImage")
  categoryImageFor   TourCategory[] @relation("CategoryImage")

  @@index([type])
  @@index([createdAt])
  @@map("media")
}

// ──────────────────────── DESTINATIONS ──────────────────────────────────────

model Destination {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  shortIntro  String
  description String        @db.Text
  status      ContentStatus @default(DRAFT)

  region    String  @default("Santa Cruz")
  country   String  @default("Argentina")
  latitude  Float?
  longitude Float?

  heroImageId String?
  heroImage   Media?  @relation("DestinationHero", fields: [heroImageId], references: [id], onDelete: SetNull)

  seoId String?      @unique
  seo   SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tours       Tour[]
  hotels      Hotel[]
  businesses  Business[]
  attractions Attraction[]
  blogPosts   BlogPost[]
  faqs        Faq[]

  @@index([status, publishedAt])
  @@index([featured])
  @@map("destinations")
}

model Attraction {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  summary     String
  description String        @db.Text
  status      ContentStatus @default(DRAFT)

  latitude  Float?
  longitude Float?
  /// Practical visitor facts. Kept factual - never invented.
  openingInfo String?
  entryFeeInfo String?

  imageId String?
  image   Media?  @relation("AttractionImage", fields: [imageId], references: [id], onDelete: SetNull)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationId])
  @@index([status])
  @@map("attractions")
}

// ────────────────────────────── TOURS ───────────────────────────────────────

model TourCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?       @db.Text
  status      ContentStatus @default(PUBLISHED)

  /// Drives which public section the category is listed under:
  /// "excursiones" | "traslados" | "servicios"
  channel   String @default("excursiones")
  sortOrder Int    @default(0)

  imageId String?
  image   Media?  @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)

  seoId String?      @unique
  seo   SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tours Tour[]

  @@index([channel, status])
  @@map("tour_categories")
}

/// A sellable tourism product: excursion, transfer or service.
/// Pricing never lives on the Tour itself - it lives on TourOption, so a
/// product can offer regular / premium / private variants.
model Tour {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  /// One-line summary shown on cards and in search results.
  summary     String
  description String        @db.Text
  status      ContentStatus @default(DRAFT)

  categoryId String
  category   TourCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  /// Denormalised "from" price in minor units - the cheapest active option.
  /// Recomputed whenever options change (see packages/db/src/pricing-sync.ts)
  /// so listing pages can sort and filter without joining every option.
  fromPriceCents Int?
  currency       String @default("ARS")

  durationMinutes Int
  difficulty      Difficulty @default(EASY)
  /// Where the activity happens, e.g. "Parque Nacional Los Glaciares".
  location        String?
  minAge          Int?
  maxGroupSize    Int?
  languages       String[]   @default(["Español", "Inglés"])

  highlights String[] @default([])
  included   String[] @default([])
  excluded   String[] @default([])
  /// Free-text operational notes shown under "Información importante".
  importantInfo String? @db.Text
  cancellationPolicy String? @db.Text

  featured  Boolean @default(false)
  sortOrder Int     @default(0)
  /// Marks rows created by `pnpm db:seed` so demo content is never mistaken
  /// for real commercial data.
  isDemo    Boolean @default(false)

  seoId String?      @unique
  seo   SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images          TourImage[]
  videos          TourVideo[]
  options         TourOption[]
  itinerary       TourItineraryStep[]
  pickupLocations TourPickupLocation[]
  availability    TourAvailability[]
  faqs            Faq[]
  reviews         Review[]
  bookingItems    BookingItem[]

  relatedTo   TourRelation[] @relation("TourRelationSource")
  relatedFrom TourRelation[] @relation("TourRelationTarget")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([destinationId])
  @@index([featured])
  @@index([fromPriceCents])
  @@index([durationMinutes])
  @@index([difficulty])
  @@map("tours")
}

model TourRelation {
  sourceId String
  targetId String
  source   Tour @relation("TourRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Tour @relation("TourRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  sortOrder Int @default(0)

  @@id([sourceId, targetId])
  @@index([targetId])
  @@map("tour_relations")
}

model TourImage {
  id       String @id @default(cuid())
  tourId   String
  tour     Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  mediaId  String
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int   @default(0)
  isCover   Boolean @default(false)

  @@unique([tourId, mediaId])
  @@index([tourId, sortOrder])
  @@map("tour_images")
}

model TourVideo {
  id       String @id @default(cuid())
  tourId   String
  tour     Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  mediaId  String
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  title    String?
  sortOrder Int   @default(0)

  @@unique([tourId, mediaId])
  @@map("tour_videos")
}

model TourItineraryStep {
  id          String  @id @default(cuid())
  tourId      String
  tour        Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  title       String
  description String  @db.Text
  /// Display-only, e.g. "08:30" or "Duración aproximada: 2 h".
  timeLabel   String?

  @@index([tourId, sortOrder])
  @@map("tour_itinerary_steps")
}

/// A purchasable variant of a Tour. This is the unit that carries price,
/// capacity and cancellation rules.
model TourOption {
  id     String @id @default(cuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  priceCents      Int
  childPriceCents Int?
  currency        String @default("ARS")

  durationMinutes Int
  /// Seats released per departure when no explicit TourAvailability row exists.
  capacity        Int    @default(20)
  minParticipants Int    @default(1)
  maxParticipants Int    @default(20)

  pickupIncluded Boolean @default(false)
  /// Default departure times, "HH:mm", used to generate availability.
  departureTimes String[] @default([])
  /// Free cancellation window. 0 disables free cancellation.
  freeCancellationHours Int @default(24)
  cancellationNote      String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availability TourAvailability[]
  bookingItems BookingItem[]

  @@index([tourId, isActive])
  @@map("tour_options")
}

/// Inventory for one option on one date (and optional departure time).
/// `seatsBooked` is incremented inside the booking transaction, and the
/// unique constraint plus a conditional update guards against overselling.
model TourAvailability {
  id       String @id @default(cuid())
  tourId   String
  tour     Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  optionId String
  option   TourOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  /// Date of the departure, normalised to UTC midnight.
  date          DateTime @db.Date
  departureTime String?

  seatsTotal  Int
  seatsBooked Int @default(0)

  /// Overrides TourOption.priceCents for this date when set (seasonality).
  priceCentsOverride Int?
  isBlocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingItems BookingItem[]

  @@unique([optionId, date, departureTime])
  @@index([tourId, date])
  @@index([date, isBlocked])
  @@map("tour_availability")
}

model TourPickupLocation {
  id     String @id @default(cuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  name      String
  address   String?
  /// Offset from the departure time, e.g. -30 means picked up 30 min before.
  offsetMinutes Int  @default(0)
  extraCostCents Int @default(0)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  bookingItems BookingItem[]

  @@index([tourId, isActive])
  @@map("tour_pickup_locations")
}

// ──────────────────── CUSTOMERS / BOOKINGS ──────────────────────────────────

model Customer {
  id        String  @id @default(cuid())
  email     String  @unique
  firstName String
  lastName  String
  phone     String?
  country   String?
  /// Where the traveller is staying - drives pickup logistics.
  hotelName String?
  notes     String? @db.Text

  /// Marketing consent captured explicitly; never assumed.
  marketingOptIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  reviews  Review[]

  @@index([createdAt])
  @@index([lastName])
  @@map("customers")
}

model Booking {
  id         String        @id @default(cuid())
  /// Human-readable reference shown to the customer, e.g. "VC-7QK3F2".
  reference  String        @unique
  status     BookingStatus @default(PENDING)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  subtotalCents Int
  discountCents Int @default(0)
  totalCents    Int
  currency      String @default("ARS")

  specialRequests String? @db.Text
  /// Internal-only notes. Never rendered on the public site.
  internalNotes   String? @db.Text

  // Marketing attribution - captured at checkout, preserved through payment.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  referrer    String?

  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      BookingItem[]
  passengers BookingPassenger[]
  payments   Payment[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("bookings")
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  tourId   String
  tour     Tour       @relation(fields: [tourId], references: [id], onDelete: Restrict)
  optionId String
  option   TourOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  availabilityId String?
  availability   TourAvailability? @relation(fields: [availabilityId], references: [id], onDelete: SetNull)

  pickupLocationId String?
  pickupLocation   TourPickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)

  /// Names are snapshotted so a later tour rename never rewrites history.
  tourNameSnapshot   String
  optionNameSnapshot String

  travelDate    DateTime @db.Date
  departureTime String?

  adults   Int @default(1)
  children Int @default(0)

  unitPriceCents      Int
  childUnitPriceCents Int @default(0)
  pickupCostCents     Int @default(0)
  subtotalCents       Int

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([tourId])
  @@index([travelDate])
  @@map("booking_items")
}

model BookingPassenger {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  type      PassengerType @default(ADULT)
  /// Optional: some national-park operators require it. Never mandatory.
  nationality String?

  @@index([bookingId])
  @@map("booking_passengers")
}

// ───────────────────────────── PAYMENTS ─────────────────────────────────────

model Payment {
  id        String @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  /// Identifier assigned by the provider (MP payment id / Stripe session id).
  providerPaymentId   String?
  providerReferenceId String?
  checkoutUrl         String? @db.Text

  amountCents Int
  currency    String @default("ARS")

  /// Last raw provider payload, for support and dispute resolution.
  /// Card data never reaches this system, so nothing sensitive is stored.
  providerPayload Json?
  failureReason   String?

  refundedCents Int @default(0)
  paidAt        DateTime?
  refundedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

/// Idempotency ledger for inbound provider webhooks. A repeated delivery of
/// the same event id is recorded once and skipped on replay.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  eventType  String
  payload    Json
  processedAt DateTime?
  error      String?  @db.Text
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

// ─────────────────────── HOTELS & BUSINESSES ────────────────────────────────

model Hotel {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  summary     String
  description String        @db.Text
  status      ContentStatus @default(DRAFT)

  /// 1–5. Only set when the property publishes an official classification.
  starRating Int?
  address    String?
  latitude   Float?
  longitude  Float?

  phone   String?
  email   String?
  website String?

  /// Indicative nightly rate in minor units. Informational only - this
  /// platform does not sell hotel inventory.
  fromPriceCents Int?
  currency       String @default("ARS")

  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  seoId String?      @unique
  seo   SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  featured Boolean @default(false)
  isDemo   Boolean @default(false)

  /// Set when the listing originated from a public submission.
  submissionId String? @unique
  submission   HotelSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  amenities HotelAmenityOnHotel[]
  images    HotelImage[]
  videos    HotelVideo[]
  reviews   Review[]

  @@index([status, publishedAt])
  @@index([destinationId])
  @@index([featured])
  @@map("hotels")
}

model HotelAmenity {
  id   String @id @default(cuid())
  key  String @unique
  name String
  /// Lucide icon name rendered by the UI.
  icon String?

  hotels HotelAmenityOnHotel[]

  @@map("hotel_amenities")
}

model HotelAmenityOnHotel {
  hotelId   String
  amenityId String
  hotel     Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity   HotelAmenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
  @@map("hotel_amenities_on_hotels")
}

model HotelImage {
  id        String @id @default(cuid())
  hotelId   String
  hotel     Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int    @default(0)
  isCover   Boolean @default(false)

  @@unique([hotelId, mediaId])
  @@map("hotel_images")
}

model HotelVideo {
  id        String @id @default(cuid())
  hotelId   String
  hotel     Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  title     String?
  sortOrder Int    @default(0)

  @@unique([hotelId, mediaId])
  @@map("hotel_videos")
}

model BusinessCategory {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  /// "restaurantes" | "servicios" - drives the public route the listing lives on.
  channel   String @default("servicios")
  icon      String?
  sortOrder Int    @default(0)

  businesses Business[]

  @@index([channel])
  @@map("business_categories")
}

model Business {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  summary     String
  description String        @db.Text
  status      ContentStatus @default(DRAFT)

  categoryId String
  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  address   String?
  latitude  Float?
  longitude Float?
  phone     String?
  email     String?
  website   String?
  /// Opening hours keyed by weekday, e.g. { "mon": "09:00-18:00" }.
  openingHours Json?
  services     String[] @default([])
  priceRange   String?

  seoId String?      @unique
  seo   SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  featured Boolean @default(false)
  isDemo   Boolean @default(false)

  submissionId String? @unique
  submission   HotelSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images  BusinessImage[]
  reviews Review[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([destinationId])
  @@map("businesses")
}

model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mediaId    String
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)

  @@unique([businessId, mediaId])
  @@map("business_images")
}

/// A public listing request from a hotel or business. Never auto-published:
/// an admin must approve it, which then creates the Hotel/Business row.
model HotelSubmission {
  id        String           @id @default(cuid())
  reference String           @unique
  status    SubmissionStatus @default(PENDING)
  /// "HOTEL" | "BUSINESS" - decides which entity approval creates.
  kind      String           @default("HOTEL")

  businessName  String
  contactName   String
  email         String
  phone         String
  website       String?
  address       String?
  description   String  @db.Text
  amenities     String[] @default([])
  services      String[] @default([])
  openingHours  String?
  /// Externally hosted image/video URLs supplied by the applicant. Stored as
  /// plain URLs and never fetched server-side, to avoid SSRF.
  imageUrls     String[] @default([])
  videoUrls     String[] @default([])
  extraInfo     String?  @db.Text

  /// Message sent back to the applicant on REJECTED / NEEDS_INFORMATION.
  reviewNotes String? @db.Text
  reviewedAt  DateTime?
  reviewedById String?
  reviewedBy   AdminUser? @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel    Hotel?
  business Business?

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("hotel_submissions")
}

// ───────────────────────────── BLOG ─────────────────────────────────────────

model BlogCategory {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?
  sortOrder   Int    @default(0)

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model BlogPost {
  id      String        @id @default(cuid())
  slug    String        @unique
  title   String
  excerpt String
  /// Markdown. Rendered server-side and sanitised before output.
  content String        @db.Text
  status  ContentStatus @default(DRAFT)

  heroImageId String?
  heroImage   Media?  @relation("BlogHero", fields: [heroImageId], references: [id], onDelete: SetNull)

  authorId String?
  author   AdminUser? @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  /// Minutes, computed from content on save.
  readingTime Int @default(1)
  featured    Boolean @default(false)
  isDemo      Boolean @default(false)

  seoId String?      @unique
  seo   SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  /// When set in the future, the post publishes automatically once reached.
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags BlogPostTag[]
  faqs Faq[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@map("blog_posts")
}

// ────────────────────── REVIEWS / FAQ / PAGES ───────────────────────────────

/// Customer reviews. Rows are only ever created from real submissions -
/// the seed script never fabricates them.
model Review {
  id     String       @id @default(cuid())
  status ReviewStatus @default(PENDING)

  rating      Int
  title       String?
  content     String  @db.Text
  authorName  String
  authorCountry String?

  tourId String?
  tour   Tour?   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  hotelId String?
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// True when the reviewer has a COMPLETED booking for the entity.
  isVerified Boolean @default(false)

  moderationNotes String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([tourId, status])
  @@index([hotelId, status])
  @@map("reviews")
}

model Faq {
  id       String   @id @default(cuid())
  scope    FaqScope @default(GLOBAL)
  question String
  answer   String   @db.Text
  sortOrder Int     @default(0)
  isPublished Boolean @default(true)

  tourId String?
  tour   Tour?   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  blogPostId String?
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, isPublished])
  @@index([tourId])
  @@map("faqs")
}

/// Editable legal / informational pages (terms, privacy, cancellation, cookies)
/// so legal copy is changed in the admin, not in a redeploy.
model StaticPage {
  id      String        @id @default(cuid())
  slug    String        @unique
  title   String
  content String        @db.Text
  status  ContentStatus @default(PUBLISHED)

  seoId String?      @unique
  seo   SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("static_pages")
}

model ContactSubmission {
  id      String        @id @default(cuid())
  status  ContactStatus @default(NEW)
  name    String
  email   String
  phone   String?
  subject String
  message String        @db.Text

  /// Set when the enquiry came from a specific tour page.
  tourSlug String?

  utmSource   String?
  utmCampaign String?
  ipAddress   String?

  handledAt DateTime?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("contact_submissions")
}

/// Key/value site configuration editable from the admin Settings screen.
model SiteSetting {
  key       String   @id
  value     Json
  /// Grouping used by the settings UI: "general" | "contact" | "social" | "seo"
  group     String   @default("general")
  label     String
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}
