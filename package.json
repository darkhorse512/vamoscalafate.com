{
  "name": "vamoscalafate",
  "version": "1.0.0",
  "private": true,
  "description": "Vamos Calafate - tourism commerce and content platform for El Calafate, Patagonia",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter ./web --filter ./admin dev",
    "dev:web": "pnpm --filter @vamos/web dev",
    "dev:admin": "pnpm --filter @vamos/admin dev",
    "build": "pnpm db:generate && pnpm --filter @vamos/web build && pnpm --filter @vamos/admin build",
    "build:web": "pnpm db:generate && pnpm --filter @vamos/web build",
    "build:admin": "pnpm db:generate && pnpm --filter @vamos/admin build",
    "start": "pnpm --parallel --filter ./web --filter ./admin start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm db:generate && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @vamos/db generate",
    "db:migrate": "pnpm --filter @vamos/db migrate",
    "db:migrate:deploy": "pnpm --filter @vamos/db migrate:deploy",
    "db:seed": "pnpm --filter @vamos/db seed",
    "db:studio": "pnpm --filter @vamos/db studio",
    "db:reset": "pnpm --filter @vamos/db reset",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0"
  }
}
