# ─────────────────────────────────────────────────────────────────────────────
# VAMOS CALAFATE — environment template
#
# Copy to `.env` at the repo root for local development, or place per-app
# `.env` files at /var/www/vamoscalafate/web/.env and .../admin/.env in
# production. NEVER commit a real `.env`.
#
# Values marked [REQUIRED] must be set or the app refuses to boot (see
# packages/shared/src/env.ts). Values marked [REQUIRED EXTERNAL CONFIG] also
# need setup in a third-party dashboard — the app cannot create them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# [REQUIRED] Server-side only. Never exposed to the browser.
DATABASE_URL="postgresql://vamos:CHANGE_ME@localhost:5432/vamoscalafate?schema=public&connection_limit=10"

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── Public URLs ─────────────────────────────────────────────────────────────
# [REQUIRED] Canonical origins. Used for canonical tags, sitemap, OG, emails.
NEXT_PUBLIC_SITE_URL="https://vamoscalafate.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.vamoscalafate.com"

# ── Authentication ──────────────────────────────────────────────────────────
# [REQUIRED] Min 32 chars. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Session lifetime in seconds (default 8h). Admin sessions are DB-backed and revocable.
AUTH_SESSION_TTL_SECONDS="28800"
# Cookie domain for the admin app. Leave blank to use a host-only cookie (recommended).
AUTH_COOKIE_DOMAIN=""

# ── Email — Resend SMTP ─────────────────────────────────────────────────────
# [REQUIRED EXTERNAL CONFIG] Create an API key at https://resend.com/api-keys
# and verify the sending domain at https://resend.com/domains.
#
# REQUIRED DNS RECORDS on vamoscalafate.com (values come from the Resend
# dashboard — they are account-specific and cannot be guessed):
#   SPF    TXT   send.vamoscalafate.com   "v=spf1 include:amazonses.com ~all"
#   DKIM   TXT   resend._domainkey        <public key provided by Resend>
#   DMARC  TXT   _dmarc                   "v=DMARC1; p=none; rua=mailto:dmarc@vamoscalafate.com"
#   MX     MX    send.vamoscalafate.com   feedback-smtp.<region>.amazonses.com (priority 10)
#
# EMAIL_TRANSPORT: "smtp" (production) | "console" (dev — prints, sends nothing)
EMAIL_TRANSPORT="console"
RESEND_SMTP_HOST="smtp.resend.com"
RESEND_SMTP_PORT="465"
RESEND_SMTP_USERNAME="resend"
# This is the Resend API key (re_...). Treat as a secret.
RESEND_SMTP_PASSWORD=""

# Must be on a domain verified in Resend. Do NOT use onboarding@resend.dev.
EMAIL_FROM="Vamos Calafate <reservas@vamoscalafate.com>"
EMAIL_REPLY_TO="reservas@vamoscalafate.com"
# Internal inbox that receives admin notifications.
EMAIL_ADMIN="reservas@vamoscalafate.com"

# ── Payments — Mercado Pago ─────────────────────────────────────────────────
# [REQUIRED EXTERNAL CONFIG] https://www.mercadopago.com.ar/developers/panel
# REQUIRED WEBHOOK: https://vamoscalafate.com/api/webhooks/mercadopago
#   Subscribe to topic: "payment". Copy the generated signing secret below.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ── Payments — Stripe ───────────────────────────────────────────────────────
# [REQUIRED EXTERNAL CONFIG] https://dashboard.stripe.com/apikeys
# REQUIRED WEBHOOK: https://vamoscalafate.com/api/webhooks/stripe
#   Events: checkout.session.completed, checkout.session.expired,
#           charge.refunded, payment_intent.payment_failed
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Which provider the checkout offers by default: "mercadopago" | "stripe"
# Providers with missing credentials are automatically hidden at checkout.
PAYMENT_DEFAULT_PROVIDER="mercadopago"
# Currency used for internal price storage and display.
DEFAULT_CURRENCY="ARS"

# ── Media storage ───────────────────────────────────────────────────────────
# "local" writes to STORAGE_LOCAL_DIR; "s3" targets any S3-compatible endpoint
# (AWS S3, Cloudflare R2, Backblaze B2).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/var/www/vamoscalafate/storage/media"
# Public base URL Nginx serves STORAGE_LOCAL_DIR from.
STORAGE_PUBLIC_URL="https://vamoscalafate.com/media"
# Only needed when STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Analytics & Search Console ──────────────────────────────────────────────
# [REQUIRED EXTERNAL CONFIG] GA4 property → Data Streams → Measurement ID.
# Safe for the browser. Leave blank to disable analytics entirely (no script loads).
NEXT_PUBLIC_GA_ID=""
# Search Console → HTML tag verification. Content of the meta tag only.
NEXT_PUBLIC_GSC_VERIFICATION=""

# ── Contact ─────────────────────────────────────────────────────────────────
# International format, digits only, no + or spaces. e.g. 5492902123456
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL="info@vamoscalafate.com"

# ── Revalidation ────────────────────────────────────────────────────────────
# [REQUIRED] Shared secret the admin app uses to purge web's cache tags.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=""

# ── Seeding ─────────────────────────────────────────────────────────────────
# Used once by `pnpm db:seed` to create the first SUPER_ADMIN.
# Change the password immediately after first login.
SEED_ADMIN_EMAIL="admin@vamoscalafate.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"
